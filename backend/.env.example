# Copy this file to .env and fill in your own values.

# Google Gemini API key — get from https://aistudio.google.com
GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Adaption Adaptive Data platform API key — get from https://adaptionlabs.ai
# Required to use real dataset upload, adaptation, and evaluation.
# Without this key, the Adaptive Intelligence module will report a "blocked" status.
ADAPTION_API_KEY=put_your_adaption_key_here

# Comma-separated list of allowed frontend origins for CORS.
# Example for production: https://agrisense-ai.vercel.app
# Leave as * for local development (no credentials).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
